---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import { 
  Server, 
  Shield, 
  Cloud, 
  Database,
  BarChart,
  CheckCircle,
  ArrowRight,
  ChevronRight,
  Cpu,
  Activity,
  Lock,
  Globe,
  Settings
} from '@lucide/astro';

const coreCapabilities = [
  {
    title: "Cloud Infrastructure Engineering",
    icon: Cloud,
    desc: "Architecting, deploying, and managing scalable cloud environments on AWS, Azure, and Cloudflare. We build resilient systems designed for 99.99% uptime.",
    features: ["Multi-Cloud Strategy", "Serverless Architectures", "Disaster Recovery"]
  },
  {
    title: "Enterprise Edge Security",
    icon: Shield,
    desc: "Perimeter hardening and zero-trust security implementations. We lock down your network with advanced WAF configurations, DDoS mitigation, and mTLS.",
    features: ["WAF Configuration", "Identity Access Management", "Traffic Scrubbing"]
  },
  {
    title: "Data Center & Database Migrations",
    icon: Database,
    desc: "Seamless, zero-downtime migrations from legacy on-premise infrastructure to modern cloud databases. Expert handling of PostgreSQL and SQL environments.",
    features: ["Zero-Downtime Migrations", "Data Integrity Audits", "Legacy Modernization"]
  },
  {
    title: "Automated DevOps Pipelines",
    icon: Settings,
    desc: "Streamlining your software delivery lifecycle with robust CI/CD pipelines, automated testing, and Infrastructure as Code (IaC) using Terraform.",
    features: ["CI/CD Implementation", "Infrastructure as Code", "Containerization (Docker)"]
  }
];

const metrics = [
  { label: "Uptime SLA", value: "99.99%" },
  { label: "Data Migrated", value: "50+ TB" },
  { label: "Support Response", value: "< 15 min" },
  { label: "Client Retention", value: "98%" }
];
---

<BaseLayout title="BCTEK CloudOps | Enterprise Infrastructure Solutions">
  <Navigation currentPath="/" />

  <main class="min-h-screen bg-slate-50 text-slate-900 font-sans selection:bg-blue-600/20">
    
    {/* ENTERPRISE HERO SECTION */}
    <section class="relative bg-slate-950 text-white overflow-hidden pt-32 pb-24 lg:pt-40 lg:pb-32">
      <div class="absolute inset-0 z-0">
        <img src="/images/corporate_hero.jpg" alt="Cloud Infrastructure" class="w-full h-full object-cover opacity-20 mix-blend-luminosity" />
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/90 to-slate-950/40"></div>
        <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-slate-50 to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-12 items-center">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-sm font-medium mb-6">
            <Activity class="w-4 h-4" />
            <span>Local Enterprise Cloud Solutions</span>
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white mb-6 leading-tight">
            Secure, Scalable <br/>
            <span class="text-blue-500">Cloud Operations</span>
          </h1>
          <p class="text-lg text-slate-300 mb-8 leading-relaxed">
            BCTEK CloudOps provides enterprise-grade infrastructure management, zero-downtime database migrations, and perimeter security hardening for businesses that demand reliability and performance.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="#consultation" class="inline-flex justify-center items-center gap-2 px-6 py-3.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-semibold transition-colors shadow-lg shadow-blue-900/20">
              Request Infrastructure Audit
              <ArrowRight class="w-4 h-4" />
            </a>
            <a href="#services" class="inline-flex justify-center items-center gap-2 px-6 py-3.5 rounded-lg border border-slate-700 bg-slate-800/50 hover:bg-slate-800 text-white font-semibold transition-colors backdrop-blur-sm">
              Explore Our Services
            </a>
          </div>
        </div>
        
        <div class="hidden lg:block relative">
           <div class="rounded-xl border border-slate-800 bg-slate-900/80 p-6 backdrop-blur-xl shadow-2xl">
             <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-800">
               <h3 class="text-sm font-semibold text-slate-300 flex items-center gap-2">
                 <Server class="w-4 h-4 text-blue-400" />
                 System Status Overview
               </h3>
               <span class="flex h-2 w-2 relative">
                 <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                 <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
               </span>
             </div>
             <div class="space-y-4">
               {[
                 { label: "Global Edge Network", status: "Operational", color: "text-emerald-400" },
                 { label: "WAF & Security Perimeter", status: "Hardened", color: "text-blue-400" },
                 { label: "Database Clusters (Primary)", status: "Synced", color: "text-emerald-400" },
                 { label: "API Gateway Routing", status: "Optimized", color: "text-emerald-400" }
               ].map(item => (
                 <div class="flex items-center justify-between text-sm">
                   <span class="text-slate-400">{item.label}</span>
                   <span class={`font-mono ${item.color}`}>{item.status}</span>
                 </div>
               ))}
             </div>
           </div>
        </div>
      </div>
    </section>

    {/* METRICS STRIP */}
    <section class="border-b border-slate-200 bg-white relative z-20 -mt-10 sm:-mt-16 max-w-6xl mx-auto rounded-xl shadow-sm overflow-hidden">
      <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-slate-100">
        {metrics.map(metric => (
          <div class="p-6 sm:p-8 text-center bg-white">
            <p class="text-3xl sm:text-4xl font-bold text-slate-900 mb-1">{metric.value}</p>
            <p class="text-sm font-medium text-slate-500 uppercase tracking-wide">{metric.label}</p>
          </div>
        ))}
      </div>
    </section>

    {/* CORE SOLUTIONS SECTION */}
    <section id="services" class="py-24 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-blue-600 font-semibold tracking-wide uppercase text-sm mb-3">Enterprise Capabilities</h2>
          <h3 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Comprehensive Cloud Engineering</h3>
          <p class="text-lg text-slate-600">
            We partner with businesses to design, implement, and secure complex technical infrastructures that scale automatically and operate seamlessly.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {coreCapabilities.map((cap) => {
            const Icon = cap.icon;
            return (
              <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow group">
                <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center mb-6 group-hover:bg-blue-600 transition-colors">
                  <Icon class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors" />
                </div>
                <h4 class="text-xl font-bold text-slate-900 mb-3">{cap.title}</h4>
                <p class="text-slate-600 mb-6 leading-relaxed">{cap.desc}</p>
                <ul class="space-y-3">
                  {cap.features.map(feature => (
                    <li class="flex items-start gap-3 text-sm text-slate-700 font-medium">
                      <CheckCircle class="w-5 h-5 text-emerald-500 shrink-0" />
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>
            )
          })}
        </div>
      </div>
    </section>

    {/* DEEP DIVE / WHY CHOOSE BCTEK */}
    <section class="py-24 bg-white border-y border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-blue-600 font-semibold tracking-wide uppercase text-sm mb-3">Technical Excellence</h2>
          <h3 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-6">Why Local Businesses Trust BCTEK for Critical Systems</h3>
          <p class="text-lg text-slate-600 mb-8">
            Your infrastructure is the backbone of your operations. We don't just maintain servers; we engineer robust platforms that drive business value, reduce operational friction, and secure your digital assets against evolving threats.
          </p>
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="w-10 h-10 rounded bg-slate-100 flex items-center justify-center shrink-0">
                <Cpu class="w-5 h-5 text-slate-700" />
              </div>
              <div>
                <h5 class="text-lg font-bold text-slate-900 mb-1">Senior-Level Engineering</h5>
                <p class="text-slate-600">Over 15 years of deep technical experience managing massive data loads, high-traffic APIs, and complex migrations without downtime.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-10 h-10 rounded bg-slate-100 flex items-center justify-center shrink-0">
                <Lock class="w-5 h-5 text-slate-700" />
              </div>
              <div>
                <h5 class="text-lg font-bold text-slate-900 mb-1">Security-First Architecture</h5>
                <p class="text-slate-600">Every deployment is secured by default. We implement zero-trust networking, comprehensive WAF rules, and strict access controls.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-10 h-10 rounded bg-slate-100 flex items-center justify-center shrink-0">
                <Globe class="w-5 h-5 text-slate-700" />
              </div>
              <div>
                <h5 class="text-lg font-bold text-slate-900 mb-1">Cost-Optimized Cloud</h5>
                <p class="text-slate-600">We audit and streamline your tech stack, eliminating redundant services and right-sizing your instances to maximize your IT budget.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="relative">
          <div class="absolute inset-0 bg-blue-100 rounded-3xl transform translate-x-4 translate-y-4 -z-10"></div>
          <img src="/images/corporate_hero.jpg" alt="Corporate Server Room" class="rounded-3xl shadow-xl border border-slate-200 object-cover aspect-[4/3]" />
        </div>
      </div>
    </section>

    {/* CALL TO ACTION */}
    <section id="consultation" class="py-24 bg-slate-900 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-blue-400 via-transparent to-transparent"></div>
      <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Ready to Optimize Your Infrastructure?</h2>
        <p class="text-xl text-slate-300 mb-10 max-w-2xl mx-auto">
          Schedule a comprehensive technical audit. We'll analyze your current setup, identify security vulnerabilities, and propose a highly scalable architecture tailored to your business needs.
        </p>
        <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
          <a href="/#contact" class="w-full sm:w-auto px-8 py-4 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-bold text-lg transition-colors shadow-lg">
            Contact Engineering Team
          </a>
          <a href="/#contact" class="w-full sm:w-auto px-8 py-4 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-bold text-lg transition-colors border border-slate-700">
            Book Tech Stack Audit
          </a>
        </div>
        <p class="mt-6 text-sm text-slate-400">Response guaranteed within 1 business day. Absolute privacy maintained.</p>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
