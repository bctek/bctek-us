---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navigation from '@/components/Navigation.astro';
import Footer from '@/components/Footer.astro';
import { 
  Bot, 
  Workflow, 
  Layers, 
  CloudDownload, 
  ShieldCheck, 
  ArrowRight, 
  Terminal, 
  Sparkles,
  Cpu
} from 'lucide-react';

const services = [
  {
    icon: Bot,
    title: "AI Apps & Custom Software",
    description: "Custom AI-powered web applications, client portals, and internal business tools built with Node.js, React/Next.js, Astro, Python, and modern AI models.",
    tag: "AI & Full-Stack",
    color: "from-cyan-500/20 to-blue-500/10 border-cyan-500/30 text-cyan-400"
  },
  {
    icon: Workflow,
    title: "API Integrations & Workflow Automation",
    description: "Connecting all your separate business apps, payment gateways, and tools into one smooth pipeline. Eliminating boring manual work with custom Python & Bash scripts.",
    tag: "Automation",
    color: "from-indigo-500/20 to-purple-500/10 border-indigo-500/30 text-indigo-400"
  },
  {
    icon: Layers,
    title: "Stack Management & Cloud Cost Cleanup",
    description: "Full audit of your tech stack to spot waste, clear out duplicate software, and optimize monthly bills while keeping your cloud resources running lean.",
    tag: "Optimization",
    color: "from-emerald-500/20 to-teal-500/10 border-emerald-500/30 text-emerald-400"
  },
  {
    icon: CloudDownload,
    title: "Cloud & Database Migrations",
    description: "Smooth, stress-free moves from legacy physical servers to AWS, Azure, or Cloudflare. Migrating and upgrading SQL & PostgreSQL databases with zero downtime.",
    tag: "Migrations",
    color: "from-amber-500/20 to-orange-500/10 border-amber-500/30 text-amber-400"
  },
  {
    icon: ShieldCheck,
    title: "Edge Security & Perimeter Hardening",
    description: "Locking down your Cloudflare WAF, DNS, SSL, and rate limits to block unwanted traffic. Managing SSH keys, user access, and securing API endpoints.",
    tag: "Security",
    color: "from-purple-500/20 to-pink-500/10 border-purple-500/30 text-purple-400"
  }
];

const techStack = [
  "Node.js", "Next.js", "Astro", "Python", "TypeScript", 
  "Cloudflare", "AWS", "Azure", "Terraform", "PostgreSQL", 
  "Docker", "Linux", "OpenAI / Gemini APIs", "REST & GraphQL APIs"
];
---

<BaseLayout title="BCTEK | AI Apps, Cloud Migrations & Infrastructure Engineering">
  <Navigation currentPath="/" />

  <main class="min-h-screen bg-[#080b11] text-slate-100 selection:bg-[#00e5ff]/30 selection:text-white pt-24 pb-20">
    
    {/* HERO SECTION */}
    <section class="relative overflow-hidden px-4 sm:px-6 lg:px-8 pt-12 pb-16 max-w-7xl mx-auto">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-gradient-to-tr from-[#00e5ff]/15 via-[#b721ff]/15 to-transparent blur-[120px] rounded-full pointer-events-none"></div>

      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-cyan-500/30 bg-cyan-950/40 text-cyan-400 text-xs font-mono mb-8 backdrop-blur-md shadow-[0_0_20px_rgba(0,229,255,0.15)]">
          <Sparkles className="w-4 h-4 text-cyan-400 animate-pulse" />
          <span>BCTEK — Principal Systems & Application Engineering</span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-[1.15] mb-6">
          We Build Custom <span class="bg-gradient-to-r from-[#00e5ff] via-[#7c3aed] to-[#b721ff] bg-clip-text text-transparent">AI Apps</span> & Automate Your <span class="bg-gradient-to-r from-cyan-400 to-indigo-400 bg-clip-text text-transparent">Cloud Infrastructure</span>.
        </h1>

        <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
          From custom CRMs and API integrations to zero-downtime database migrations and Cloudflare security.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="#contact" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-gradient-to-r from-[#00e5ff] to-[#7c3aed] text-slate-950 font-bold text-base hover:opacity-90 transition-all shadow-[0_0_25px_rgba(0,229,255,0.3)] hover:scale-[1.02]"
          >
            <span>Book a Technical Audit</span>
            <ArrowRight className="w-5 h-5" />
          </a>
          <a 
            href="#services" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl border border-slate-800 bg-slate-900/60 text-slate-300 hover:text-white hover:bg-slate-800/80 transition-all backdrop-blur-md"
          >
            <span>Explore Services</span>
          </a>
        </div>
      </div>
    </section>

    {/* TERMINAL HIGHLIGHT */}
    <section class="max-w-5xl mx-auto px-4 mb-20">
      <div class="rounded-2xl border border-slate-800 bg-slate-950/90 shadow-2xl overflow-hidden backdrop-blur-xl">
        <div class="flex items-center justify-between px-4 py-3 bg-slate-900/80 border-b border-slate-800">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-rose-500"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
            <span class="ml-2 text-xs font-mono text-slate-400">bctek-console // system-status</span>
          </div>
          <div class="flex items-center gap-1 text-xs font-mono text-cyan-400">
            <Cpu className="w-3.5 h-3.5" />
            <span>OPERATIONAL</span>
          </div>
        </div>

        <div class="p-6 font-mono text-xs sm:text-sm text-slate-300 space-y-3 leading-relaxed">
          <p className="text-slate-500">$ bctek status --all</p>
          <p className="text-emerald-400">✓ Full-Stack Application Engine: ACTIVE (Node.js, Next.js, Astro, Python)</p>
          <p className="text-cyan-400">✓ Cloud & Database Migrations: READY (Zero-Downtime Guarantee)</p>
          <p className="text-indigo-400">✓ Edge Security & WAF Perimeter: HARDENED (Cloudflare, Rate Limits, SSL)</p>
          <p className="text-amber-400">✓ Tech Stack & Cost Audit: ONLINE (No Fluff, Max Efficiency)</p>
          <div class="pt-2 text-slate-400 flex items-center gap-2">
            <span class="text-cyan-400">bctek@system:~$</span>
            <span class="animate-pulse">Ready to solve your technical bottlenecks.</span>
          </div>
        </div>
      </div>
    </section>

    {/* CORE SERVICES GRID */}
    <section id="services" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs font-mono uppercase tracking-widest text-cyan-400 mb-3">Our Core Capabilities</h2>
        <p class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Everything You Need to Build, Automate, & Scale Your Tech Stack.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((s) => {
          const Icon = s.icon;
          return (
            <div class={`group relative p-8 rounded-2xl border bg-gradient-to-b ${s.color} backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:shadow-xl`}>
              <div class="flex items-center justify-between mb-6">
                <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800 text-white">
                  <Icon class="w-6 h-6 text-cyan-400" />
                </div>
                <span class="text-[10px] font-mono uppercase px-2.5 py-1 rounded-full bg-slate-900/80 border border-slate-800 text-slate-300">
                  {s.tag}
                </span>
              </div>
              <h3 class="text-xl font-bold text-white mb-3 group-hover:text-cyan-300 transition-colors">
                {s.title}
              </h3>
              <p class="text-sm text-slate-400 leading-relaxed">
                {s.description}
              </p>
            </div>
          );
        })}
      </div>
    </section>

    {/* TECH STACK SHOWCASE */}
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="p-8 sm:p-12 rounded-3xl border border-slate-800 bg-slate-950/60 backdrop-blur-md text-center">
        <h3 class="text-xs font-mono uppercase tracking-widest text-indigo-400 mb-3">Engineered With Proven Tech</h3>
        <h4 class="text-2xl font-bold text-white mb-8">Modern Tools for Fast Apps & Bulletproof Cloud</h4>
        <div class="flex flex-wrap items-center justify-center gap-3">
          {techStack.map((tech) => (
            <span class="px-4 py-2 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 text-xs font-mono hover:border-cyan-500/50 hover:text-cyan-300 transition-colors">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </section>

    {/* LEAD GEN SECTION */}
    <section id="contact" class="max-w-4xl mx-auto px-4 py-16">
      <div class="relative overflow-hidden rounded-3xl border border-cyan-500/30 bg-gradient-to-r from-cyan-950/40 via-slate-950 to-purple-950/40 p-8 sm:p-12 backdrop-blur-xl shadow-2xl">
        <div class="text-center space-y-4">
          <h3 class="text-3xl font-extrabold text-white tracking-tight">
            Ready to Build or Upgrade Your System?
          </h3>
          <p class="text-slate-400 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
            Get in touch with BCTEK. Whether you need a custom AI app, an API integration, a cloud migration, or stack optimization—let's discuss your project.
          </p>
          <div class="pt-6 flex items-center justify-center gap-4">
            <a 
              href="mailto:bctek@proton.me" 
              class="px-8 py-4 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold text-sm transition-all shadow-[0_0_20px_rgba(0,229,255,0.4)]"
            >
              Contact BCTEK: bctek@proton.me
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
