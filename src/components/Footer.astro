---
import { Mail, Phone, MapPin } from '@lucide/astro';

const currentYear = new Date().getFullYear();

const footerLinks = {
  services: [
    { label: 'Cloud Infrastructure', href: '/#services' },
    { label: 'Edge Security', href: '/#services' },
    { label: 'Data Migrations', href: '/#services' },
    { label: 'Infrastructure Audit', href: '/#contact' },
  ],
  company: [
    { label: 'About BCTEK', href: '/#services' },
    { label: 'Our Approach', href: '/#services' },
    { label: 'Client Portal', href: '/#contact' },
  ],
  legal: [
    { label: 'Privacy Policy', href: '#' },
    { label: 'Terms of Service', href: '#' },
    { label: 'Service Level Agreement', href: '#' },
  ],
};
---

<footer class="bg-slate-900 border-t border-slate-800 pt-16 pb-8 px-4 sm:px-6 lg:px-8 text-slate-300">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      {/* Brand Column */}
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-6 group">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-600 shadow-md">
            <span class="text-lg font-black text-white font-mono">BC</span>
          </div>
          <div class="flex flex-col">
            <span class="font-bold text-lg text-white group-hover:text-blue-400 transition-colors">BCTEK</span>
            <span class="text-[10px] font-semibold uppercase tracking-widest text-slate-400">CloudOps</span>
          </div>
        </a>
        
        <p class="text-sm text-slate-400 leading-relaxed mb-6">
          Enterprise cloud architecture, edge security, and database migrations for businesses demanding reliability.
        </p>
        
        <div class="space-y-3">
          <a href="/#contact" class="flex items-center gap-3 text-sm text-slate-400 hover:text-blue-400 transition-colors">
            <Mail class="h-4 w-4" />
            Contact Support
          </a>
          <div class="flex items-center gap-3 text-sm text-slate-400">
            <MapPin class="h-4 w-4" />
            United States
          </div>
        </div>
      </div>

      {/* Services Column */}
      <div>
        <h4 class="font-bold text-sm text-white uppercase tracking-wider mb-4">Core Solutions</h4>
        <ul class="space-y-3">
          {footerLinks.services.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-slate-400 hover:text-blue-400 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Company Column */}
      <div>
        <h4 class="font-bold text-sm text-white uppercase tracking-wider mb-4">Company</h4>
        <ul class="space-y-3">
          {footerLinks.company.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-slate-400 hover:text-blue-400 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Legal Column */}
      <div>
        <h4 class="font-bold text-sm text-white uppercase tracking-wider mb-4">Legal & Compliance</h4>
        <ul class="space-y-3">
          {footerLinks.legal.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-slate-400 hover:text-blue-400 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="border-t border-slate-800 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-slate-500">
        © {currentYear} BCTEK CloudOps. All rights reserved.
      </p>
    </div>
  </div>
</footer>
