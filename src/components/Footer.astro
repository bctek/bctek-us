---
import { Mail, Phone, MapPin } from '@lucide/astro';

const currentYear = new Date().getFullYear();

const footerLinks = {
  services: [
    { label: 'Edge Security & WAF', href: '/#services' },
    { label: 'Cloud & CDN Performance', href: '/#services' },
    { label: 'Fractional DevOps', href: '/#services' },
    { label: 'Infrastructure Audit', href: '/#contact' },
  ],
  company: [
    { label: 'About Us', href: '/about' },
    { label: 'Case Studies', href: '/case-studies' },
    { label: 'Blog', href: '/blog' },
    { label: 'Careers', href: '/careers' },
  ],
  resources: [
    { label: 'Documentation', href: '/docs' },
    { label: 'Status Page', href: '/status' },
    { label: 'Support', href: '/support' },
    { label: 'Terms of Service', href: '/terms' },
  ],
};
---

<footer class="border-t border-white/10 bg-[#080b11] pt-16 pb-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      {/* Brand Column */}
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-gradient-to-br from-[#00e5ff] to-[#b721ff] p-0.5">
            <div class="flex h-full w-full items-center justify-center rounded-[6px] bg-[#080b11]">
              <span class="text-sm font-black text-[#00e5ff]">BC</span>
            </div>
          </div>
          <div class="flex flex-col">
            <span class="font-mono text-lg font-bold text-white">BCTEK</span>
            <span class="text-[10px] font-mono uppercase tracking-widest text-[#00e5ff]/60">Cloud & DevOps</span>
          </div>
        </a>
        
        <p class="text-sm text-[#94a3b8] leading-relaxed mb-6">
          Bulletproof edge security and infrastructure automation for modern B2B companies.
        </p>
        
        <div class="space-y-3">
          <a href="mailto:hello@bctek.io" class="flex items-center gap-3 text-sm text-[#94a3b8] hover:text-[#00e5ff] transition-colors">
            <Mail class="h-4 w-4" />
            hello@bctek.io
          </a>
          <a href="tel:+15551234567" class="flex items-center gap-3 text-sm text-[#94a3b8] hover:text-[#00e5ff] transition-colors">
            <Phone class="h-4 w-4" />
            (555) 123-4567
          </a>
          <div class="flex items-center gap-3 text-sm text-[#94a3b8]">
            <MapPin class="h-4 w-4" />
            Remote-First, US-Based
          </div>
        </div>
      </div>

      {/* Services Column */}
      <div>
        <h4 class="font-mono text-xs font-semibold text-white uppercase tracking-wider mb-4">Services</h4>
        <ul class="space-y-3">
          {footerLinks.services.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-[#94a3b8] hover:text-[#00e5ff] transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Company Column */}
      <div>
        <h4 class="font-mono text-xs font-semibold text-white uppercase tracking-wider mb-4">Company</h4>
        <ul class="space-y-3">
          {footerLinks.company.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-[#94a3b8] hover:text-[#00e5ff] transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Resources Column */}
      <div>
        <h4 class="font-mono text-xs font-semibold text-white uppercase tracking-wider mb-4">Resources</h4>
        <ul class="space-y-3">
          {footerLinks.resources.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-[#94a3b8] hover:text-[#00e5ff] transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-[#94a3b8]">
        © {currentYear} BCTEK Cloud & DevOps. All rights reserved.
      </p>
      
      <div class="flex items-center gap-4">
        <a href="https://github.com/bctek" target="_blank" rel="noopener noreferrer" class="text-[#94a3b8] hover:text-[#00e5ff] transition-colors font-mono text-sm">
          GitHub
        </a>
        <a href="https://linkedin.com/company/bctek" target="_blank" rel="noopener noreferrer" class="text-[#94a3b8] hover:text-[#00e5ff] transition-colors font-mono text-sm">
          LinkedIn
        </a>
        <a href="https://twitter.com/bctek" target="_blank" rel="noopener noreferrer" class="text-[#94a3b8] hover:text-[#00e5ff] transition-colors font-mono text-sm">
          Twitter
        </a>
      </div>
    </div>
  </div>
</footer>
