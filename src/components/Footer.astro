---
interface Props {
  year?: number;
  mainLink?: string;
  fieldServicesLink?: string;
}

const { year = new Date().getFullYear(), mainLink = '/', fieldServicesLink = '/field-services' } = Astro.props;
---

<footer class="mt-20 border-t border-white/10 bg-black/40 py-12 text-zinc-400 backdrop-blur-md">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      {/* Brand Column */}
      <div class="md:col-span-2 space-y-4">
        <a href={mainLink} class="flex items-center gap-2.5 font-display text-xl font-extrabold tracking-tight text-white">
          <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br from-[#00e5ff] to-[#b721ff] p-0.5">
            <div class="flex h-full w-full items-center justify-center rounded-[6px] bg-[#1a1a24]">
              <span class="text-[10px] font-black text-[#00e5ff]">BC</span>
            </div>
          </div>
          <span class="bg-gradient-to-r from-white to-zinc-400 bg-clip-text text-transparent">BCTEK</span>
        </a>
        <p class="text-xs text-zinc-400 max-w-sm leading-relaxed">
          Modern Boutique MSP. Specializing in SaaS integration, MDM & remote administration, cloud server migrations, and reliable local field dispatch.
        </p>
        <div class="flex items-center gap-2 font-mono text-xs text-[#00e5ff]">
          <span class="h-2 w-2 rounded-full bg-[#00e5ff] animate-pulse"></span>
          <span>Site First Focus Team</span>
        </div>
      </div>

      {/* Core Solutions Links */}
      <div>
        <h4 class="font-display text-xs font-bold uppercase tracking-wider text-white mb-4">Core Solutions</h4>
        <ul class="space-y-2.5 text-xs">
          <li><a href="/#expertise" class="hover:text-[#00e5ff] transition-colors">SaaS Integration</a></li>
          <li><a href="/#expertise" class="hover:text-[#00e5ff] transition-colors">MDM & Remote Admin</a></li>
          <li><a href="/#expertise" class="hover:text-[#00e5ff] transition-colors">Server Migrations</a></li>
          <li><a href="/#expertise" class="hover:text-[#00e5ff] transition-colors">Stack Management</a></li>
          <li><a href="/#tiers" class="hover:text-[#00e5ff] transition-colors">MSP Tiers & Pricing</a></li>
        </ul>
      </div>

      {/* Field & Contact Links */}
      <div>
        <h4 class="font-display text-xs font-bold uppercase tracking-wider text-white mb-4">Operations</h4>
        <ul class="space-y-2.5 text-xs">
          <li><a href={fieldServicesLink} class="text-[#00e5ff] hover:underline transition-colors font-medium">Boots on the Ground (Field Services)</a></li>
          <li><a href="/#stack" class="hover:text-[#00e5ff] transition-colors">Systems & Partner Stack</a></li>
          <li><a href="/#contact" class="hover:text-[#00e5ff] transition-colors">Dispatch & Support</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-white/5 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500">
      <p>&copy; {year} BCTEK. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href={fieldServicesLink} class="hover:text-zinc-300 transition-colors">Local Field Services</a>
        <a href="/#contact" class="hover:text-zinc-300 transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
