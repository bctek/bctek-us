---
import { Bot, Workflow, Layers, CloudDownload, ShieldCheck, Zap, Terminal } from '@lucide/astro';
---

<section class="relative min-h-screen flex items-center justify-center px-4 sm:px-6 lg:px-8 pt-28 pb-20">
  <div class="absolute top-32 left-8 hidden lg:block">
    <div class="glass rounded-lg p-3 text-xs font-mono text-[#00e5ff]/80">
      <span class="text-[#27c93f]">$</span> node build-app.js --ai-model=gemini
    </div>
  </div>
  
  <div class="absolute top-48 right-12 hidden lg:block">
    <div class="glass rounded-lg p-3 text-xs font-mono text-[#ffbd2e]/80">
      <span class="text-[#ff5f56]">!</span> db-migration --status=zero-downtime
    </div>
  </div>

  <div class="absolute bottom-32 left-16 hidden lg:block">
    <div class="glass rounded-lg p-3 text-xs font-mono text-[#b721ff]/80">
      <span class="text-[#00e5ff]">→</span> Cloudflare WAF: 100% hardened
    </div>
  </div>

  <div class="max-w-5xl mx-auto text-center">
    <div class="inline-flex items-center gap-2 rounded-full border border-[#00e5ff]/30 bg-[#00e5ff]/10 px-4 py-2 font-mono text-xs text-[#00e5ff] mb-8 shadow-[0_0_20px_rgba(0,229,255,0.2)]">
      <Zap class="h-3.5 w-3.5" />
      <span>BCTEK — PRINCIPAL SYSTEMS & APP ENGINEERING</span>
      <span class="h-1.5 w-1.5 rounded-full bg-[#00e5ff] animate-pulse"></span>
    </div>

    <h1 class="font-mono text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-white mb-6 leading-tight">
      We Build Custom <span class="bg-gradient-to-r from-[#00e5ff] via-[#b721ff] to-[#00e5ff] bg-clip-text text-transparent">AI Apps</span> & Automate Your <span class="text-[#00e5ff]">Cloud Infrastructure</span>.
    </h1>

    <p class="text-lg sm:text-xl text-[#94a3b8] mb-10 max-w-3xl mx-auto leading-relaxed">
      From custom CRMs and API integrations to zero-downtime database migrations and Cloudflare security.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <a
        href="#contact"
        class="group relative inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-[#00e5ff] to-[#b721ff] px-8 py-4 text-base font-semibold text-black transition-all hover:shadow-[0_0_30px_rgba(0,229,255,0.5)] hover:scale-105"
      >
        <Zap class="h-4 w-4" />
        Book a Technical Audit
        <span class="absolute -right-1 -top-1 h-3 w-3 rounded-full bg-[#27c93f] animate-pulse"></span>
      </a>
      
      <a
        href="#services"
        class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-8 py-4 text-base font-medium text-white transition-all hover:bg-white/10 hover:border-[#00e5ff]/30"
      >
        <Terminal class="h-4 w-4" />
        Explore Services
      </a>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-6 text-xs sm:text-sm font-mono text-[#94a3b8]">
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-[#27c93f]"></span>
        <span>Custom Apps & CRMs</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-[#00e5ff]"></span>
        <span>Zero-Downtime Migrations</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-[#b721ff]"></span>
        <span>Edge & WAF Hardening</span>
      </div>
    </div>
  </div>
</section>
