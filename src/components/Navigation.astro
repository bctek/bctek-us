---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { label: 'Cloud Solutions', href: '/#services' },
  { label: 'Technology', href: '/#stack' },
  { label: 'Security', href: '/#security' },
  { label: 'Contact', href: '/#contact' },
];
---

<nav
  class="fixed top-0 left-0 right-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur-md shadow-sm"
  role="navigation"
  aria-label="Main navigation"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    {/* Logo */}
    <a href="/" class="group flex items-center gap-3">
      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-600 shadow-md transition-transform duration-300 group-hover:scale-105">
        <span class="text-lg font-black text-white font-mono">BC</span>
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-lg tracking-tight text-slate-900 group-hover:text-blue-600 transition-colors">
          BCTEK
        </span>
        <span class="text-[10px] font-semibold uppercase tracking-widest text-slate-500">
          CloudOps
        </span>
      </div>
    </a>

    {/* Desktop Links */}
    <div class="hidden items-center gap-1 md:flex">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class:list={[
              'rounded-md px-4 py-2 text-sm font-semibold transition-all duration-200',
              isActive
                ? 'bg-slate-100 text-blue-600'
                : 'text-slate-600 hover:text-blue-600 hover:bg-slate-50',
            ]}
          >
            {link.label}
          </a>
        );
      })}
    </div>

    {/* Right Controls */}
    <div class="flex items-center gap-4">
      <a 
        href="/#contact" 
        class="hidden rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white transition-all hover:bg-blue-500 shadow-sm sm:inline-block"
      >
        Client Portal
      </a>

      {/* Mobile Hamburger */}
      <button
        id="nav-hamburger"
        class="flex flex-col items-center justify-center gap-1.5 p-2 rounded-md hover:bg-slate-100 md:hidden"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
      >
        <span class="block h-0.5 w-5 rounded-full bg-slate-700 transition-all duration-300" id="hamburger-top"></span>
        <span class="block h-0.5 w-5 rounded-full bg-slate-700 transition-all duration-300" id="hamburger-mid"></span>
        <span class="block h-0.5 w-5 rounded-full bg-slate-700 transition-all duration-300" id="hamburger-bot"></span>
      </button>
    </div>
  </div>

  {/* Mobile Menu */}
  <div
    id="nav-mobile-menu"
    class="hidden border-b border-slate-200 bg-white md:hidden"
    role="menu"
  >
    <div class="flex flex-col px-4 py-4 space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          role="menuitem"
          class:list={[
            'rounded-md px-4 py-3 text-sm font-semibold transition-colors duration-200',
            currentPath === link.href
              ? 'bg-slate-50 text-blue-600'
              : 'text-slate-700 hover:bg-slate-50 hover:text-blue-600',
          ]}
        >
          {link.label}
        </a>
      ))}
      <div class="pt-4 mt-2 border-t border-slate-100">
        <a
          href="/#contact"
          class="block w-full rounded-lg bg-blue-600 px-4 py-3 text-center text-sm font-semibold text-white hover:bg-blue-500"
        >
          Client Portal
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  function initNav() {
    const hamburger = document.getElementById('nav-hamburger');
    const mobileMenu = document.getElementById('nav-mobile-menu');
    const topBar = document.getElementById('hamburger-top');
    const midBar = document.getElementById('hamburger-mid');
    const botBar = document.getElementById('hamburger-bot');

    if (!hamburger || !mobileMenu || !topBar || !midBar || !botBar) return;

    hamburger.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.toggle('hidden') === false;
      hamburger.setAttribute('aria-expanded', String(isOpen));

      if (isOpen) {
        topBar.classList.add('translate-y-2', 'rotate-45');
        midBar.classList.add('opacity-0');
        botBar.classList.add('-translate-y-2', '-rotate-45');
      } else {
        topBar.classList.remove('translate-y-2', 'rotate-45');
        midBar.classList.remove('opacity-0');
        botBar.classList.remove('-translate-y-2', '-rotate-45');
      }
    });
  }

  document.addEventListener('astro:page-load', initNav);
  initNav();
</script>
